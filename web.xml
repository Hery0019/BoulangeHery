<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                      http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
  version="3.1"
  metadata-complete="true">

  <display-name>Gotta taste</display-name>
  <description>
    A recipe web application
  </description>


  <!-- Journalise les exceptions non gérées et renvoie 400/500 sans pile d'appels (voir servlet.ErrorFilter) -->
  <filter>
    <filter-name>ErrorFilter</filter-name>
    <filter-class>servlet.ErrorFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>ErrorFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- Jeton anti-CSRF exigé sur toute requête modifiante (voir servlet.CsrfFilter) -->
  <filter>
    <filter-name>CsrfFilter</filter-name>
    <filter-class>servlet.CsrfFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>CsrfFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- Contrôle d'accès : tout est protégé sauf la consultation publique (voir servlet.AuthFilter) -->
  <filter>
    <filter-name>AuthFilter</filter-name>
    <filter-class>servlet.AuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- Servlet name definition -->
  <servlet>
    <servlet-class>servlet.RecipeServlet</servlet-class>
    <servlet-name>RecipeServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.RecipeDetailsServlet</servlet-class>
    <servlet-name>RecipeDetailsServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.RecipeIngredientServlet</servlet-class>
    <servlet-name>RecipeIngredientServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.FormRecipeServlet</servlet-class>
    <servlet-name>FormRecipeServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.FormRecipeIngredientServlet</servlet-class>
    <servlet-name>FormRecipeIngredientServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.CategoryServlet</servlet-class>
    <servlet-name>CategoryServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.FormCategoryServlet</servlet-class>
    <servlet-name>FormCategoryServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.IngredientServlet</servlet-class>
    <servlet-name>IngredientServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.FormIngredientServlet</servlet-class>
    <servlet-name>FormIngredientServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.StepServlet</servlet-class>
    <servlet-name>StepServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.FormStepServlet</servlet-class>
    <servlet-name>FormStepServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.ReviewServlet</servlet-class>
    <servlet-name>ReviewServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.FormReviewServlet</servlet-class>
    <servlet-name>FormReviewServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.LoginServlet</servlet-class>
    <servlet-name>LoginServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.FormLoginServlet</servlet-class>
    <servlet-name>FormLoginServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.FormRecipeSellServlet</servlet-class>
    <servlet-name>FormRecipeSellServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.RecipeSellServlet</servlet-class>
    <servlet-name>RecipeSellServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.CommissionServlet</servlet-class>
    <servlet-name>CommissionServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.RecipePriceHistoryServlet</servlet-class>
    <servlet-name>RecipePriceHistoryServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.RecipeStockServlet</servlet-class>
    <servlet-name>RecipeStockServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.PictureServlet</servlet-class>
    <servlet-name>PictureServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.ProductionServlet</servlet-class>
    <servlet-name>ProductionServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.FormProductionServlet</servlet-class>
    <servlet-name>FormProductionServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.IngredientStockServlet</servlet-class>
    <servlet-name>IngredientStockServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.RecipeLossServlet</servlet-class>
    <servlet-name>RecipeLossServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.FormRecipeLossServlet</servlet-class>
    <servlet-name>FormRecipeLossServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.ExportServlet</servlet-class>
    <servlet-name>ExportServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.ClientServlet</servlet-class>
    <servlet-name>ClientServlet</servlet-name>
  </servlet>

  <servlet>
    <servlet-class>servlet.FormClientServlet</servlet-class>
    <servlet-name>FormClientServlet</servlet-name>
  </servlet>



  <!-- Servlet mapping -->
  <servlet-mapping>
    <servlet-name>RecipeServlet</servlet-name>
    <url-pattern>/recipe</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>RecipeDetailsServlet</servlet-name>
    <url-pattern>/recipe-details</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>RecipeIngredientServlet</servlet-name>
    <url-pattern>/recipe-ingredient</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>FormRecipeServlet</servlet-name>
    <url-pattern>/form-recipe</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>FormRecipeIngredientServlet</servlet-name>
    <url-pattern>/form-recipe-ingredient</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>CategoryServlet</servlet-name>
    <url-pattern>/category</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>FormCategoryServlet</servlet-name>
    <url-pattern>/form-category</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>IngredientServlet</servlet-name>
    <url-pattern>/ingredient</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>FormIngredientServlet</servlet-name>
    <url-pattern>/form-ingredient</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>StepServlet</servlet-name>
    <url-pattern>/step</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>FormStepServlet</servlet-name>
    <url-pattern>/form-step</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>ReviewServlet</servlet-name>
    <url-pattern>/review</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>FormReviewServlet</servlet-name>
    <url-pattern>/form-review</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>FormLoginServlet</servlet-name>
    <url-pattern>/form-login</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>FormRecipeSellServlet</servlet-name>
    <url-pattern>/form-recipe-sell</url-pattern>
  </servlet-mapping>
 
 <servlet-mapping>
    <servlet-name>RecipeSellServlet</servlet-name>
    <url-pattern>/recipe-sell</url-pattern>
  </servlet-mapping>  

   <servlet-mapping>
    <servlet-name>CommissionServlet</servlet-name>
    <url-pattern>/commission</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>RecipePriceHistoryServlet</servlet-name>
    <url-pattern>/recipe-price-history</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>RecipeStockServlet</servlet-name>
    <url-pattern>/recipe-stock</url-pattern>
  </servlet-mapping>

  <!-- Photos téléversées, stockées hors du WAR (voir util.Pictures) -->
  <servlet-mapping>
    <servlet-name>PictureServlet</servlet-name>
    <url-pattern>/pictures/*</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>ProductionServlet</servlet-name>
    <url-pattern>/production</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>FormProductionServlet</servlet-name>
    <url-pattern>/form-production</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>IngredientStockServlet</servlet-name>
    <url-pattern>/ingredient-stock</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>RecipeLossServlet</servlet-name>
    <url-pattern>/recipe-loss</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>FormRecipeLossServlet</servlet-name>
    <url-pattern>/form-recipe-loss</url-pattern>
  </servlet-mapping>

  <!-- Export CSV des ventes et des commissions -->
  <servlet-mapping>
    <servlet-name>ExportServlet</servlet-name>
    <url-pattern>/export</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>ClientServlet</servlet-name>
    <url-pattern>/client</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>FormClientServlet</servlet-name>
    <url-pattern>/form-client</url-pattern>
  </servlet-mapping>

  <!-- Sessions : expiration après 30 min d'inactivité, cookie inaccessible au JavaScript.
       Passer <secure>true</secure> dès que l'application est servie en HTTPS. -->
  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <!-- Pool de connexions déclaré dans META-INF/context.xml -->
  <resource-ref>
    <res-ref-name>jdbc/boulangerie</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
    <res-auth>Container</res-auth>
  </resource-ref>

  <!-- Pages d'erreur neutres (aucune pile d'appels ni requête SQL exposée) -->
  <error-page>
    <error-code>400</error-code>
    <location>/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>403</error-code>
    <location>/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>404</error-code>
    <location>/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/error.jsp</location>
  </error-page>
  <error-page>
    <exception-type>java.lang.Throwable</exception-type>
    <location>/error.jsp</location>
  </error-page>

</web-app>